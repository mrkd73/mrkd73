# Copy to .env and adjust as needed for local development.
# These values match the defaults used by scripts/db-setup.sh.

# Database (DB_HOST=localhost => PHP connects over the unix socket,
# which matches the 'wordpress'@'localhost' MariaDB account).
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=wordpress
WP_DB_HOST=localhost

# Dev web server
WP_PORT=8080
WP_URL=http://localhost:8080

# Site + admin bootstrap (dev only credentials)
WP_TITLE="mrkd73 Dev"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
